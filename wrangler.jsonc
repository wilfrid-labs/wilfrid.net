{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "wilfrid-net",
	// Serve production only through the dashboard-managed Custom Domain.
	// preview_urls controls Version URLs; future Worker Previews need separate settings.
	"workers_dev": false,
	"preview_urls": false,
	// Omit routes: CI must not manage the existing Custom Domain or DNS.
	// Astro's Cloudflare adapter supplies the Worker entrypoint when deployed.
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Wrangler uploads the built site, not the Astro source files.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
