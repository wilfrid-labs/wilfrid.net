# Astro and Cloudflare build output; generated again by `npm run build`.
dist/

# Astro's generated route and type metadata; recreated by Astro commands.
.astro/

# Installed packages; restore from package-lock.json with `npm ci`.
node_modules/

# Package manager and local browser/runtime logs; not source files.
npm-debug.log*
debug.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local secrets and environment-specific values; keep out of Git.
.env
.env.production
.env.*

# Finder metadata created on macOS.
.DS_Store

# Local IDE settings; each developer can configure their own.
.idea/

# Wrangler cache and local secret files; do not commit credentials.
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
