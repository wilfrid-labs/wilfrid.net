---
import Layout from '../layouts/Layout.astro';
import EmailReveal from '../components/EmailReveal.astro';
import { projects, site } from '../data/site';

export const prerender = true;
const expertise = [
  { number: '01', title: 'Software & systems', text: 'C++, low-level systems, and computing architecture.', tags: 'C++ / Systems / Architecture' },
  { number: '02', title: 'Computer graphics', text: 'Rendering, game engines, and performance-oriented software.', tags: 'Rendering / GPU / Performance' },
  { number: '03', title: 'Machine learning & AI', text: 'Areas I’m currently learning: machine learning, AI infrastructure, and GPU computing.', tags: 'Machine learning / AI engineering', exploring: true },
];
---
<Layout>
  <div class="shell">
    <header class="site-header">
      <a class="identity" href="/" aria-label="Wilfrid Girard — home"><span class="wordmark">{site.fullName}</span><span class="identity-domain">wilfrid.net</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a><a href="#projects">Projects</a><a href="#notebook">Notebook</a><a href="#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Software engineering · Computer graphics · AI</p>
          <h1 id="hero-title">Working across graphics, systems, and AI.<br /><span>Exploring what’s next.</span></h1>
          <p class="hero-intro">Building software at the intersection<br class="desktop-break" /> of graphics, systems, and AI.</p>
          <p class="hero-description">From real-time rendering to the foundations of computing. Exploring how things work, and how to make them work better.</p>
          <div class="hero-actions">
            <a class="button" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="#about">A little about me <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>
      <section id="about" class="section" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow section-index">About</p>
          <div><h2 id="about-title">What I work on</h2>
          <p class="section-intro">I’m a software engineer with around 20 years of experience building real-time and performance-focused systems. At Unity and Silicon Studio, I worked on graphics technology, console platforms, and rendering research, turning demanding technical work into tools and features teams can ship. I enjoy helping creators master complex technology and achieve ambitious goals. I’m now exploring how that systems experience extends to infrastructure and AI.</p></div>
        </div>
        <div class="expertise-grid">
          {expertise.map((area) => (
            <article class="expertise">
              <div class="expertise-top"><span class="mono">{area.number}</span>{area.exploring && <span class="small-label accent">Exploring</span>}</div>
              <h3>{area.title}</h3><p>{area.text}</p><p class="expertise-tags mono">{area.tags}</p>
            </article>
          ))}
        </div>
      </section>
      <section id="projects" class="section" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="eyebrow section-index">Projects</p>
          <div class="heading-with-link"><h2 id="projects-title">Projects on GitHub</h2><a class="text-link external-link" href={site.github}>All repositories <span aria-hidden="true">↗</span></a></div>
        </div>
        <p class="projects-intro">Past projects from <a class="external-link" href="https://github.com/wip-">wip- <span aria-hidden="true">↗</span></a> and <a class="external-link" href="https://github.com/Wilfrid-Unity">Wilfrid-Unity <span aria-hidden="true">↗</span></a>.</p>
        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project">
              <div class={`project-visual ${project.visual}`} aria-hidden="true">
                {project.visual === 'spectrum' ? (
                  <svg viewBox="0 0 520 190" fill="none">
                    <defs><linearGradient id="spectrum" x1="80" y1="0" x2="440" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#70618b"/><stop offset=".25" stop-color="#3c6c87"/><stop offset=".5" stop-color="#38715a"/><stop offset=".75" stop-color="#9b7e38"/><stop offset="1" stop-color="#a45544"/></linearGradient></defs>
                    <path d="M60 150H460M100 35v115m80-115v115m80-115v115m80-115v115m80-115v115M60 110h400M60 70h400" stroke="var(--text)" stroke-opacity=".12" />
                    <path d="M60 146C105 146 112 55 160 55S208 140 255 140 300 46 350 46 405 145 460 145" stroke="url(#spectrum)" stroke-width="2.5"/>
                    <path d="M60 146c65 0 80-51 125-51s65 25 95 25 70-50 100-50 40 74 80 75" stroke="url(#spectrum)" stroke-opacity=".4" stroke-dasharray="4 5"/>
                    <g fill="var(--muted)" font-size="10" font-family="monospace"><text x="60" y="172">380 nm</text><text x="422" y="172">780 nm</text></g>
                  </svg>
                ) : (
                  <div class="sample-grid">{Array.from({ length: 15 }, (_, i) => <span class:list={['sample-cell', { highlighted: i === 7 }]}><i></i><i></i><i></i><i></i></span>)}</div>
                )}
                <span class="visual-note mono">{project.category}</span>
              </div>
              <div class="project-copy">
                <div class="project-meta mono"><a class="external-link" href={project.profileUrl}>{project.profile}</a><span>{project.year}</span></div>
                <div class="project-title"><h3><a class="external-link" href={project.url}>{project.name}</a></h3><span aria-hidden="true">↗</span></div>
                <p>{project.description}</p>
                <ul class="tags" aria-label="Project topics">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section id="notebook" class="section notebook" aria-labelledby="notebook-title">
        <div class="section-heading">
          <p class="eyebrow section-index">Writing</p>
          <div><p class="small-label accent notebook-status"><span class="status-dot"></span> Planned</p>
            <h2 id="notebook-title">Writing & experiments</h2>
            <p class="section-intro">I plan to share notes on rendering, systems, and AI, along with interactive experiments.</p>
            <div class="notebook-topics mono"><span>Technical articles</span><span>Graphics experiments</span><span>Interactive explorations</span></div>
          </div>
        </div>
      </section>
      <section id="contact" class="section contact" aria-labelledby="contact-title">
        <p class="eyebrow">Contact</p>
        <div class="contact-content"><div><h2 id="contact-title">Get in touch</h2></div>
          <div class="contact-links">
            <EmailReveal />
            <a class="text-link external-link" href="https://calendly.com/wilfrid-girard" target="_blank" rel="noreferrer"><svg class="social-icon appointment-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M7 3v4M17 3v4M3 10h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><rect x="7" y="13" width="4" height="4" rx=".7" fill="currentColor"/><path d="m15 13 4 2.5-4 2.5v-5Z" fill="currentColor"/></svg> Book a call <span aria-hidden="true">↗</span></a>
            <a class="text-link external-link" href={site.linkedin}><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.63H4.96V9.07h2.97v9.56ZM6.45 7.76a1.72 1.72 0 1 1 .02-3.44 1.72 1.72 0 0 1-.02 3.44Zm12.18 10.87h-2.97v-4.65c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.35V9.07h2.85v1.31h.04c.4-.75 1.37-1.55 2.82-1.55 3.01 0 3.57 1.98 3.57 4.56v5.25Z"/></svg> LinkedIn <span aria-hidden="true">↗</span></a>
            <a class="text-link external-link" href={site.github}><svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.08c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.59 1.2 3.22.92.1-.72.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.06 1.14a10.63 10.63 0 0 1 5.57 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.12 2.96.71.78 1.14 1.78 1.14 3 0 4.29-2.62 5.23-5.11 5.5.4.34.75 1 .75 2.02V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg> GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} {site.fullName}</span><a href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
  </div>
</Layout>
